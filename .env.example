# Forest rasters are served as WMS images reprojected to the Leaflet map CRS.
# Raw GeoTIFF/COG URLs are intentionally not consumed directly by the browser.
VITE_FOREST_WMS_URL=http://localhost:8600/geoserver/nffis/wms
VITE_FOREST_RASTER_MANIFEST_URL=/forest-rasters/manifest.json
VITE_FOREST_TYPE_WMS_URL=/api/forest-type-wms

VITE_FOREST_TYPE_WMS_LAYER=nffis:forest_type_2021_bih
VITE_FOREST_FAGUS_WMS_LAYER=nffis:fagus_sylvatica_bih
VITE_FOREST_ABIES_WMS_LAYER=nffis:abies_alba_bih
VITE_FOREST_PICEA_WMS_LAYER=nffis:picea_abies_bih
VITE_FOREST_PINUS_NIGRA_WMS_LAYER=nffis:pinus_nigra_bih
VITE_FOREST_PINUS_SYLVESTRIS_WMS_LAYER=nffis:pinus_sylvestris_bih
VITE_FOREST_QUERCUS_PETRAEA_WMS_LAYER=nffis:quercus_petraea_bih
VITE_FOREST_QUERCUS_ROBUR_WMS_LAYER=nffis:quercus_robur_bih
VITE_FOREST_QUERCUS_CERRIS_WMS_LAYER=nffis:quercus_cerris_bih
VITE_FOREST_CASTANEA_WMS_LAYER=nffis:castanea_sativa_bih
